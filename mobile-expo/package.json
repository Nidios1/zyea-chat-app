{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --clear",
    "start:expo-go": "expo start --go --clear",
    "clean": "rm -rf node_modules .expo && npm install",
    "clean:win": "powershell -Command \"Remove-Item -Recurse -Force node_modules, .expo -ErrorAction SilentlyContinue\" && npm install",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "ios:dev": "expo run:ios",
    "prebuild:ios": "node prebuild-ios.js",
    "build": "build.bat",
    "build:ipa": "build-ipa.bat",
    "build:ipa:unsigned": "eas build --platform ios --profile unsigned --non-interactive",
    "setup:git": "setup-git-remote.bat",
    "commit:push": "commit-and-push.bat",
    "eas:build:unsigned": "eas build --platform ios --profile unsigned --non-interactive",
    "eas:build:adhoc": "eas build --platform ios --profile adhoc --non-interactive",
    "eas:build:preview": "eas build --platform ios --profile preview --non-interactive",
    "eas:build:production": "eas build --platform ios --profile production --non-interactive",
    "update:ip": "node update-api-ip.js",
    "check:wifi": "node check-ipa-wifi.js",
    "update:publish": "node publish-update.js production",
    "update:publish:preview": "node publish-update.js preview",
    "update:check": "eas update:list"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.5.0",
    "@react-navigation/bottom-tabs": "^7.7.0",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/stack": "^7.6.1",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.13.0",
    "expo": "54.0.23",
    "expo-av": "~16.0.7",
    "expo-barcode-scanner": "^13.0.1",
    "expo-blur": "~15.0.7",
    "expo-camera": "^17.0.9",
    "expo-constants": "~18.0.0",
    "expo-device": "^8.0.9",
    "expo-image": "^3.0.10",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-file-system": "~18.0.4",
    "expo-media-library": "~17.0.3",
    "expo-notifications": "^0.32.12",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.12",
    "fs-extra": "^11.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "cross-env": "^7.0.3",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
