# Dependencies
node_modules/
*/node_modules/

# Build outputs
build/
dist/
*/build/

# iOS - Ignore builds
client/ios/App/build/
client/ios/App/Pods/
client/ios/App/*.xcworkspace
client/ios/App/*.xcodeproj
*.ipa
*.dSYM

# Keep iOS config files
!client/ios/App/exportOptions.plist

# mobile-expo iOS - Keep native folder but ignore build artifacts
mobile-expo/ios/build/
mobile-expo/ios/Pods/
mobile-expo/ios/*.xcworkspace
mobile-expo/ios/*.xcodeproj
mobile-expo/ios/DerivedData/

# But keep the ios/ folder structure itself
!mobile-expo/ios/
!mobile-expo/ios/**/*.plist
!mobile-expo/ios/**/*.pbxproj
!mobile-expo/ios/**/*.h
!mobile-expo/ios/**/*.m
!mobile-expo/ios/**/*.swift
!mobile-expo/ios/**/*.xcconfig

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Environment
.env
*.env

# Logs
*.log
